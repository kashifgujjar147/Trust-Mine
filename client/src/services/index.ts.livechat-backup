export const supportService={

  getTickets:()=>getOr<SupportTicket[]>(
    '/support',
    m.tickets,
    'tickets'
  ),

  async createTicket(input:{
    subject:string;
    message:string
  }){

    if(mockMode){

      const t:SupportTicket={
        _id:nowId('s'),
        ...input,
        status:'OPEN',
        createdAt:new Date().toISOString()
      };

      m.tickets.unshift(t);

      return delay(t);
    }

    return (
      await api.post('/support',input)
    ).data;
  },

  getMessages:async(ticketId:string)=>{
    if(mockMode){
      const ticket=m.tickets.find(x=>x._id===ticketId);
      if(!ticket) throw new Error('Support ticket not found');
      return delay([]);
    }

    return (await api.get(`/support/${ticketId}/messages`)).data;
  },

  sendMessage:async(ticketId:string,message:string)=>{
    const clean=message.trim();
    if(!clean) throw new Error('Message is required');

    if(mockMode){
      const ticket=m.tickets.find(x=>x._id===ticketId);
      if(!ticket) throw new Error('Support ticket not found');
      if(ticket.status==='RESOLVED') throw new Error('This conversation is resolved');

      ticket.message=clean;
      ticket.lastMessageAt=new Date().toISOString();
      ticket.lastMessagePreview=clean.slice(0,160);
      ticket.unreadForAdmin=(ticket.unreadForAdmin||0)+1;
      ticket.unreadForUser=0;

      return delay({
        _id:nowId('sm'),
        ticketId,
        senderId:m.mockUser._id,
        senderRole:'USER',
        message:clean,
        createdAt:new Date().toISOString()
      });
    }

    return (
      await api.post(
        `/support/${ticketId}/messages`,
        {message:clean}
      )
    ).data;
  },

  markRead:async(ticketId:string)=>{
    if(mockMode){
      const ticket=m.tickets.find(x=>x._id===ticketId);
      if(ticket) ticket.unreadForUser=0;
      return delay(true);
    }

    return (
      await api.post(
        `/support/${ticketId}/read`
      )
    ).data;
  }

