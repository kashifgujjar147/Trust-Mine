NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://your-vercel-domain.vercel.app
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app
PAYMENT_MODE=manual
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
BEP20_RPC_URL=
BEP20_WALLET_ADDRESS=
EASYPAISA_PROVIDER_URL=
EASYPAISA_API_KEY=
BANK_VERIFICATION_PROVIDER=
# true = fail startup if MongoDB does not support multi-document transactions
# Use true for controlled production deployments on a replica set/sharded cluster.
MONGODB_TRANSACTIONS_REQUIRED=true

# Internal withdrawal processing configuration (not shown to members)
WITHDRAWAL_TIMEZONE=Asia/Karachi
WHATSAPP_CHANNEL_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_SECRET=

# Optional password-reset delivery webhook. The server never returns reset tokens in production.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

