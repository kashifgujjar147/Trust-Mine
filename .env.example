NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/trust-mine
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
PAYMENT_MODE=manual
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
BEP20_RPC_URL=
BEP20_WALLET_ADDRESS=
EASYPAISA_PROVIDER_URL=
EASYPAISA_API_KEY=
BANK_VERIFICATION_PROVIDER=
# true = fail startup if MongoDB does not support multi-document transactions
# Use true for controlled production deployments on a replica set/sharded cluster.
MONGODB_TRANSACTIONS_REQUIRED=false
